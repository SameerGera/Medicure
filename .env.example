# Medicure — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
# Public base URL (use ngrok during local dev so Twilio can reach you)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.dev

# --- Database ---
# SQLite for prototype; swap to a postgresql:// URL for production.
DATABASE_URL=sqlite:///./medicure.db

# --- Gemini (Vision LLM for prescription parsing) ---
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash

# --- Twilio (WhatsApp ingestion + patient routing) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
